# 이 파일을 .env.local 로 복사해서 채우세요.

# 앱 잠금 비밀번호 (Vercel 에 올릴 땐 필수)
APP_PASSWORD=

# eBay 개발자 키 — https://developer.ebay.com/my/keys
EBAY_ENV=production            # 또는 sandbox
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_RUNAME=                   # User Tokens → "Get a Token from eBay via Your Application" 의 RuName
EBAY_MARKETPLACE=EBAY_US       # EBAY_GB, EBAY_DE, EBAY_AU, EBAY_CA
EBAY_USE_INSIGHTS=0            # Marketplace Insights(판매완료 시세) 승인을 받았으면 1

# 배포 주소 (계정 삭제 알림 검증 / OAuth 안내용)
PUBLIC_BASE_URL=https://your-app.vercel.app
EBAY_VERIFICATION_TOKEN=       # 32~80자 아무 문자열, eBay 개발자 콘솔에도 같은 값 입력

# 매일 자동 스캔 (Vercel Cron)
CRON_SECRET=

# 저장소 — Vercel 에서 Upstash Redis 를 연결하면 자동으로 들어옴. 로컬은 비워두면 ./data 폴더 사용
KV_REST_API_URL=
KV_REST_API_TOKEN=
